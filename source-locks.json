{
  "schemaVersion": 1,
  "sources": {
    "ram": {
      "repository": "https://github.com/Allura-Ecosystem/allura-team-ram.git",
      "commit": "42dbd25f01539b5296ae636871ad032b61267c43",
      "version": "0.5.1",
      "defaultDirectory": "../allura-team-ram",
      "mappings": [
        {
          "source": "agents",
          "destination": "agents/ram"
        },
        {
          "source": ".opencode/skills",
          "destination": "skills/ram"
        },
        {
          "source": ".opencode/contracts/adaptive-workflow.md",
          "destination": "policies/ram/adaptive-workflow.md"
        }
      ],
      "exclude": [
        ".opencode/skills/figma-create-new-file",
        ".opencode/skills/skill-creator/scripts/__pycache__"
      ],
      "exclusionReason": "Preserve the canonical invocation-disabled Figma skill restriction; omit committed Python runtime bytecode."
    },
    "durham": {
      "repository": "https://github.com/Allura-Ecosystem/team-durham.git",
      "commit": "a6fd21f3855be2ff9b701d79f0554ac57d09047f",
      "version": "0.4.1",
      "defaultDirectory": "../team-durham",
      "mappings": [
        {
          "source": "agents",
          "destination": "agents/durham"
        },
        {
          "source": "skills",
          "destination": "skills/durham"
        },
        {
          "source": "governance",
          "destination": "policies/durham/governance"
        },
        {
          "source": "contracts",
          "destination": "policies/durham/contracts"
        }
      ],
      "exclude": []
    }
  }
}
